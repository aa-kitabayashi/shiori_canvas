; ─────────────────────────────────────────────
;  automation.js 設定ファイル (サンプル)
;  このファイルを config.ini にコピーして値を書き換えてください
;  ※ パスは Windows でも「/」区切りが安全です（\ でも可）
; ─────────────────────────────────────────────

; フォルダー監視設定
[watch]
input_dir     = C:/dev/automation/input
processed_dir = C:/dev/automation/processed
error_dir     = C:/dev/automation/error

; ログイン情報
[login]
url      = https://example.com/login
id       = your_login_id
password = your_password

; サイト設定（相対パス遷移の基準URL）
[site]
base_url = https://example.com

; LINE WORKS 通知設定（未設定なら通知しない）
; LINE WORKS Developer Console (https://dev.worksmobile.com/) でアプリと Bot を作成し、
; Client ID / Client Secret / Service Account / Private Key(ダウンロード) / Bot ID を取得する
[lineworks]
client_id        = your_client_id
client_secret    = your_client_secret
service_account  = xxxxx.serviceaccount@your-domain
private_key_path = ./private_key.pem
bot_id           = 1234567
; 通知先: トークルームに送るなら channel_id、個人に送るなら user_id（channel_id 優先）
channel_id       =
user_id          =
